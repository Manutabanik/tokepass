NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Production: public HTTPS origin only, without a trailing path.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Alias opcional de NEXT_PUBLIC_SITE_URL
# NEXT_PUBLIC_BASE_URL=https://www.tokepass.com.ar
# NEXT_PUBLIC_APP_URL=https://www.tokepass.com.ar
# Set to 1 in non-Vercel production CI to enforce the prebuild environment check.
# REQUIRE_PRODUCTION_ENV=1

# Mercado Pago (Checkout Pro) — canónico o alias corto (ambos válidos)
# Para Sandbox local usá Access Token de PRUEBA (empieza con TEST-), no APP_USR.
MERCADOPAGO_ACCESS_TOKEN=TEST-your-access-token
MERCADOPAGO_WEBHOOK_SECRET=your-webhook-secret
# MP_ACCESS_TOKEN=TEST-your-access-token
# MP_WEBHOOK_SECRET=your-webhook-secret
# NEXT_PUBLIC_MP_PUBLIC_KEY=TEST-your-public-key
# NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=TEST-your-public-key
# Email del comprador de prueba (Sandbox). Si falta, se omite payer en non-prod.
# MP_SANDBOX_BUYER_EMAIL=test_user_123456@testuser.com
# MERCADOPAGO_SANDBOX_BUYER_EMAIL=test_user_123456@testuser.com
# Forzar sandbox aunque NODE_ENV=production (solo pruebas controladas)
# MP_FORCE_SANDBOX=1

# Cron jobs (Vercel Cron Authorization: Bearer CRON_SECRET)
CRON_SECRET=generate-a-long-random-secret

# Optional Upstash Redis (healthcheck PING + waiting room FIFO).
# Production with WAITING_ROOM_ENABLED requires Redis; there is no in-memory fallback.
# UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-upstash-token
# WAITING_ROOM_ENABLED=1
# Fase 8 local: MAX_CONCURRENT_USERS=0 forces /event/[id]/queue.
# Then set MAX_CONCURRENT_USERS=1 and restart `npm run dev` to auto-admit.
# MAX_CONCURRENT_USERS=2000
# WAITING_ROOM_MAX_CAPACITY=2000
# Required in production. Locally a per-process secret is generated if unset.
# WAITING_ROOM_SECRET=generate-a-long-random-secret

# Optional Sentry — official SDK (@sentry/nextjs). Public DSN is required for the browser.
# NEXT_PUBLIC_SENTRY_DSN=https://publicKey@o0.ingest.sentry.io/0
# Server-only fallback if the public DSN is unset:
# SENTRY_DSN=https://publicKey@o0.ingest.sentry.io/0
# SENTRY_ENVIRONMENT=production
# Optional source-map upload during CI (never commit the token):
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=

# Optional operational notifications.
# NOTIFICATION_WEBHOOK_URL=https://your-ops-webhook
# Required in production (prebuild). Verified domain in Resend.
RESEND_API_KEY=re_xxxxxxxxx
# RESEND_FROM_EMAIL=Tokepass <notificaciones@your-domain.com>

# PWA is enabled automatically in production. Set only to test it locally.
# NEXT_PUBLIC_PWA=1

# Organizer onboarding
# ORGANIZER_INVITE_ONLY=true
# ORGANIZER_INVITE_CODE=secret-invite

# Optional commercial sponsorship requests (organizer CTA)
# NEXT_PUBLIC_TOKEPASS_COMMERCIAL_WHATSAPP=54911XXXXXXXX
# NEXT_PUBLIC_TOKEPASS_COMMERCIAL_EMAIL=comercial@tokepass.com.ar

# Native wallets — PassKit / Google Wallet Issuer. PEM can be raw or base64.
# APPLE_PASS_TYPE_ID=pass.com.tokepass.ticket
# APPLE_TEAM_ID=
# APPLE_PASS_SIGNER_CERT=
# APPLE_PASS_SIGNER_KEY=
# APPLE_PASS_SIGNER_KEY_PASSPHRASE=
# APPLE_PASS_WWDR_CERT=
# GOOGLE_WALLET_ISSUER_ID=
# GOOGLE_WALLET_CLASS_ID=
# GOOGLE_WALLET_SERVICE_ACCOUNT_JSON=
# GOOGLE_WALLET_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_WALLET_SERVICE_ACCOUNT_PRIVATE_KEY=
# GOOGLE_WALLET_SA_PRIVATE_KEY_ID=
# NEXT_PUBLIC_APPLE_WALLET_ENABLED=false
# NEXT_PUBLIC_GOOGLE_WALLET_ENABLED=false

# E2E (Playwright) — staging only. Never point at production Mercado Pago.
# E2E_BASE_URL=http://localhost:3000
# E2E_EVENT_ID=uuid-del-evento-masivo-de-staging
# E2E_BUYER_EMAIL=qa.buyer@example.com
# E2E_BUYER_PASSWORD=replace-me
# E2E_ORGANIZER_EMAIL=qa.organizer@example.com
# E2E_ORGANIZER_PASSWORD=replace-me
# E2E_EXPECTED_PRICE=25000

# k6 load tests — staging Supabase only. Smoke is default; spike is opt-in.
# K6_SUPABASE_URL=https://your-staging.supabase.co
# K6_SUPABASE_ANON_KEY=your-anon-key
# K6_SERVICE_ROLE_KEY=staging-service-role-only
# K6_EVENT_ID=uuid
# K6_TIER_ID=uuid
# K6_SEATING_UNIT_ID=uuid-mesa-12
# K6_OWNER_IDS=uuid-buyer-1,uuid-buyer-2
# K6_NEXT_ORIGIN=http://localhost:3000
# K6_SCENARIO=smoke

# Gobi — canal oficial WhatsApp (order.paid → HSM Living Ticket)
GOBI_WEBHOOK_URL=https://your-gobi-host/api/webhooks/tokepass
GOBI_WEBHOOK_SECRET=shared-hmac-secret-with-gobi
# TOKEPASS_GOBI_WEBHOOK_URL=https://your-gobi-host/api/webhooks/tokepass
# TOKEPASS_WEBHOOK_SECRET=shared-hmac-secret-with-gobi

# Naranja X (adapter opcional de pagos). WEBHOOK_SECRET es fail-closed: sin el, el POST se ignora.
# NARANJAX_API_BASE_URL=
# NARANJAX_API_KEY=
# NARANJAX_PRIVATE_KEY=
# NARANJAX_MERCHANT_ID=
# NARANJAX_WEBHOOK_SECRET=

# Payway (adapter opcional). WEBHOOK_SECRET es fail-closed: sin el, el POST se ignora.
# PAYWAY_API_BASE_URL=
# PAYWAY_PRIVATE_KEY=
# PAYWAY_SITE_ID=
# PAYWAY_WEBHOOK_SECRET=

# Captcha (opcional). Guest checkout no lo requiere.
# NEXT_PUBLIC_CAPTCHA_PROVIDER=recaptcha
# NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# RECAPTCHA_SECRET_KEY=
# RECAPTCHA_SECRET=
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# CLOUDFLARE_TURNSTILE_SECRET_KEY=

# Footer legal AFIP
# NEXT_PUBLIC_AFIP_QR_URL=https://www.afip.gob.ar/

# Guest checkout uses native Zod + in-memory IP rate limit. No captcha service required.
# Required in production (prebuild). Dedicated HMAC; no fallback to CRON_SECRET.
GUEST_TICKET_SECRET=generate-a-long-random-secret
# Short-lived httpOnly cookie for /checkout/success when auth.uid() is missing.
# Required in production (prebuild). Also authorizes POST /api/send-tickets.
CHECKOUT_FULFILLMENT_SECRET=generate-a-long-random-secret

# Spotify Web API — solo servidor (Client Credentials). Nunca NEXT_PUBLIC_*.
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
