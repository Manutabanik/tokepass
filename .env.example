NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Mercado Pago (Checkout Pro)
# Access Token de producción o TEST-... de sandbox
MERCADOPAGO_ACCESS_TOKEN=TEST-your-access-token
# Secret de la firma del webhook (Tus integraciones → Webhooks)
MERCADOPAGO_WEBHOOK_SECRET=your-webhook-secret

# Gobi — canal oficial WhatsApp (order.paid → HSM Living Ticket)
# Debe coincidir con TOKEPASS_WEBHOOK_SECRET en Gobi
GOBI_WEBHOOK_URL=https://your-gobi-host/api/webhooks/tokepass
GOBI_WEBHOOK_SECRET=shared-hmac-secret-with-gobi
